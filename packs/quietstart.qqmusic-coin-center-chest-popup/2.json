      "version": 1,
      "priority": 310,
      "appliesTo": [
        "com.tencent.hm.qqmusic"
      ],
      "when": {
        "trigger": "app-foreground",
        "lifetime": "foreground"
      },
      "defaults": {
        "totalMs": 60000,
        "limit": {
          "maxWidth": 0.95,
          "maxHeight": 0.15,
          "maxArea": 0.12
        }
      },
      "steps": [
        {
          "find": {
            "by": "text",
            "match": [
              "金币定位310-5-0"
            ],
            "limit": {
              "maxWidth": 0.95,
              "maxHeight": 0.15,
              "maxArea": 0.12
            },
            "explicit": false,
            "normalise": [
              {
                "pattern": "^返回$",
                "replace": "金币定位310-5-0"
              }
            ]
          },
          "need": {
            "visibleText": [
              "每日任务"
            ],
            "absentText": [
              "观看广告+",
              "看广告后可领取",
              "点击后看"
            ],
            "evidence": {
              "text": [
                "宝箱当前可领取"
              ],
              "cta": [
                "^领金币$"
              ]
            }
          },
          "do": {
            "capability": "swipe",
            "from": [
              0.86111,
              0.88328
            ],
            "to": [
              0.86746,
              0.88328
