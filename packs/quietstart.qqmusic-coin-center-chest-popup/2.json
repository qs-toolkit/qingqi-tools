              "领取成功~",
              "领取成功"
            ],
            "settleMs": 8000,
            "samples": 2
          },
          "markerEvidenceLabel": "宝箱当前可领取"
        },
        {
          "find": {
            "by": "text",
            "match": [
              "关闭广告"
            ],
            "explicit": false,
            "idHints": [
              [
                "close",
                "金币定位310-5-1"
              ],
              [
                "CloseButton",
                "金币定位310-5-1"
              ],
              [
                "close_text",
                "金币定位310-5-1"
              ]
            ],
            "limit": {
              "maxWidth": 0.12,
              "maxHeight": 0.08,
              "maxArea": 0.01
            }
          },
          "need": {
            "visibleText": [
              "恭喜已获得奖励",
              "恭喜获得奖励",
              "恭喜你已获得奖励",
              "已观看广告"
            ],
            "evidence": {
              "text": [
                "恭喜已获得奖励",
                "恭喜获得奖励",
                "恭喜你已获得奖励",
                "已观看广告"
              ]
            }
          },
          "do": {
            "capability": "click"
          },
          "expect": {
            "result": "gone",
            "settleMs": 15000,
            "samples": 2
          },
          "skipWhen": {
            "visibleText": [
              "金币TAB"
            ],
            "absentText": [
              "点击后看",
              "恭喜已获得奖励",
              "恭喜获得奖励",
              "已观看广告"
            ],
            "stopRepeat": false
          }
        },
        {
          "find": {
            "by": "text",
            "match": [
              "金币定位310-5-2"
            ],
            "normalise": [
              {
                "pattern": "^关闭$",
                "replace": "金币定位310-5-2"
              }
            ],
            "limit": {
              "maxWidth": 0.24,
              "maxHeight": 0.1,
              "maxArea": 0.02
            }
          },
          "need": {
            "visibleText": [
              "看广告后可领取"
            ],
            "absentText": [
              "点击后看",
              "恭喜已获得奖励"
            ]
          },
          "do": {
            "capability": "click"
          },
          "expect": {
            "result": "gone",
            "settleMs": 5000,
            "samples": 2
          },
          "skipWhen": {
            "visibleText": [
              "金币TAB"
            ],
            "absentText": [
              "看广告后可领取"
            ],
            "stopRepeat": false
          }
        }
      ]
    },
