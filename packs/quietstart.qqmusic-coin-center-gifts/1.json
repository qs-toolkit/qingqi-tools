{
  "schema": 3,
  "id": "quietstart.qqmusic-coin-center-gifts",
  "name": "QQ音乐金币中心·礼物浏览",
  "version": 1,
  "minAppVersionCode": 128000,
  "minAppVersionName": "1.2.8",
  "usage": "从QQ音乐「我的」页右上角金币，或签到页右上角金币进入。保持在金币中心赚金币页。礼物区最多浏览4次，每次至少15秒；外跳后返回，应用市场拦截返回时唤回QQ音乐。不安装、不兑换。与金币视频配置配套使用；测试时先停用原QQ音乐免会员包。",
  "appliesTo": [
    "com.tencent.hm.qqmusic"
  ],
  "entryAfterClick": "免费领礼物-鸿蒙",
  "entryClickTexts": [
    "赚金币",
    "看广告后可领取"
  ],
  "landingVisit": {
    "promptText": "浏览15秒",
    "promptKeywords": [
      "浏览"
    ],
    "maxPendingRetries": 3,
    "promptRegion": [
      0.25,
      0.47,
      0.98,
      0.61
    ],
    "buttonRegion": [
      0.45,
      0.535,
      0.6,
      0.545
    ],
    "dwellMs": 15000,
    "chooserTexts": [
      "选择应用",
      "选择打开方式",
      "应用分身",
      "打开方式",
      "微信1"
    ],
    "confirmContexts": [
      "是否确认",
      "确认打开",
      "即将打开",
      "是否打开",
      "想要打开"
    ],
    "confirmButton": "确定",
    "confirmButtons": [
      "打开"
    ],
    "externalOpenPolicy": "open",
    "cancelButton": "取消",
    "dismissPoint": [
      0.5,
      0.15
    ],
    "backFrom": [
      0.005,
      0.52
    ],
    "backTo": [
      0.285,
      0.52
    ],
    "backSpeed": 2600,
    "externalReturnText": "QQ音乐",
    "returnPolicy": "wake-owner",
    "returnAbility": {
      "moduleName": "entry",
      "abilityName": "EntryAbility"
    },
    "earnedTexts": [
      "今日活动任务已完成",
      "待领取"
    ],
    "landingPages": [
      {
        "containerType": "UIExtensionComponent",
        "allIds": [
          "app_name",
          "download_button_text"
        ],
        "anyText": [
          "安装",
          "打开",
          "更新"
        ],
        "dwellMs": 15000,
        "returnPolicy": "back-then-wake-owner",
        "wakeFromBundles": [
          "com.huawei.hmsapp.appgallery"
        ]
      }
    ]
  },
  "tasks": [
    {
      "schema": 2,
      "id": "quietstart.qqmusic-coin-center-entry-top-1",
      "name": "第1区前恢复金币页顶部1",
      "version": 1,
      "priority": 180,
      "appliesTo": [
        "com.tencent.hm.qqmusic"
      ],
      "when": {
        "trigger": "app-foreground",
        "lifetime": "foreground"
      },
      "defaults": {
        "totalMs": 15000,
        "limit": {
          "maxWidth": 0.95,
          "maxHeight": 0.15,
          "maxArea": 0.12
        }
      },
      "steps": [
        {
          "find": {
            "by": "text",
            "match": [
              "金币定位180-0-0"
            ],
            "normalise": [
              {
                "pattern": "^返回$",
                "replace": "金币定位180-0-0"
              }
            ]
          },
          "need": {
            "visibleText": [
              "每日任务"
            ],
            "absentText": [
              "点击后看",
              "观看广告+",
              "可获得奖励"
            ]
          },
          "do": {
            "capability": "swipe",
            "from": [
              0.6,
              0.42
            ],
            "to": [
              0.6,
              0.9
            ],
            "speed": 2200
          },
          "expect": {
            "result": "appeared",
            "match": [
              "免费领礼物-鸿蒙"
            ],
            "onScreen": true,
            "settleMs": 5000,
            "samples": 2
          }
        }
      ]
    },
