{
  "schema": 3,
  "id": "quietstart.qidian-welfare-center",
  "name": "起点读书福利中心任务奖励",
  "version": 9,
  "usage": "在起点读书「我的」页，用户点击「福利中心」。新用户点击后会跳到新人页面，需要在新人页面滑到页面底部点「查看更多福利」。\n进入常规福利中心后轻启会自动运行，不用干预。",
  "appliesTo": [
    "com.qidian.reader"
  ],
  "landingVisit": {
    "promptText": "可获得奖励",
    "promptKeywords": [
      "点击"
    ],
    "maxPendingRetries": 5,
    "promptRegion": [
      0.02,
      0.04,
      0.98,
      0.35
    ],
    "buttonRegion": [
      0.05,
      0.55,
      0.95,
      0.92
    ],
    "dwellMs": 15000,
    "chooserTexts": [
      "选择应用",
      "选择打开方式",
      "应用分身",
      "打开方式",
      "微信1"
    ],
    "confirmContexts": [
      "是否确认",
      "确认打开",
      "即将打开",
      "是否打开",
      "想要打开"
    ],
    "confirmButton": "确定",
    "confirmButtons": [
      "打开"
    ],
    "externalOpenPolicy": "open",
    "cancelButton": "取消",
    "dismissPoint": [
      0.5,
      0.14
    ],
    "backFrom": [
      0.005,
      0.52
    ],
    "backTo": [
      0.4,
      0.52
    ],
    "backSpeed": 800,
    "externalReturnText": "起点读书",
    "returnPolicy": "wake-owner",
    "returnAbility": {
      "moduleName": "AppEntry",
      "abilityName": "MainTabAbility"
    },
    "earnedTexts": [
      "恭喜已获得奖励",
      "恭喜获得奖励"
    ]
  },
  "tasks": [
    {
      "schema": 2,
      "id": "quietstart.qidian-welfare-reward",
      "name": "起点读书福利中心广告奖励",
      "version": 6,
      "priority": 200,
      "appliesTo": [
        "com.qidian.reader"
      ],
      "when": {
        "trigger": "app-foreground",
        "lifetime": "foreground"
      },
      "defaults": {
        "totalMs": 120000,
        "limit": {
          "maxWidth": 0.5,
          "maxHeight": 0.12,
          "maxArea": 0.05
        }
      },
      "repeat": {
        "maxCycles": 5,
        "cooldownMs": 500,
        "idleMs": 30000,
        "stopWhen": {
          "text": "已领取",
          "nearText": "激励任务"
        }
      },
      "steps": [
        {
          "find": {
            "by": "text",
            "match": [
              "去完成"
            ],
            "sameParentText": [
              "激励任务"
            ],
            "limit": {
              "maxWidth": 0.25,
              "maxHeight": 0.08,
              "maxArea": 0.02
            }
          },
          "need": {
            "visibleText": [
              "完成任务得奖励"
            ],
            "absentText": [
              "恭喜获得"
            ],
            "evidence": {
              "text": [
                "完成任务得奖励"
              ]
            }
          },
          "do": {
            "capability": "click"
          },
          "expect": {
            "result": "gone",
            "settleMs": 10000,
            "samples": 2
          }
        },
        {
          "find": {
            "by": "text",
            "match": [
              "关闭广告"
            ],
            "explicit": false,
            "idHints": [
              [
                "close",
                "关闭广告"
              ]
            ],
            "limit": {
              "maxWidth": 0.12,
              "maxHeight": 0.08,
              "maxArea": 0.01
            }
          },
          "need": {
            "visibleText": [
              "恭喜获得奖励",
              "恭喜已获得奖励"
            ],
            "evidence": {
              "text": [
                "恭喜获得奖励",
                "恭喜已获得奖励"
              ]
            }
          },
          "do": {
            "capability": "click"
          },
          "expect": {
            "result": "gone",
            "settleMs": 10000,
            "samples": 2
          }
        },
        {
          "find": {
            "by": "text",
            "match": [
              "知道了"
            ],
            "limit": {
              "maxWidth": 0.25,
              "maxHeight": 0.1,
              "maxArea": 0.025
            }
          },
          "need": {
            "visibleText": [
              "恭喜获得"
            ]
          },
          "do": {
            "capability": "click"
          },
          "expect": {
            "result": "gone",
            "settleMs": 12000,
            "samples": 2
          },
          "skipWhen": {
            "visibleText": [
              "完成任务得奖励"
            ],
            "absentText": [
              "恭喜获得"
            ],
            "stopRepeat": true
          }
        }
      ]
    },
