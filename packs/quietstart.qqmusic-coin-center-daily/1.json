      "version": 1,
      "priority": 280,
      "appliesTo": [
        "com.tencent.hm.qqmusic"
      ],
      "when": {
        "trigger": "app-foreground",
        "lifetime": "foreground"
      },
      "defaults": {
        "totalMs": 240000,
        "limit": {
          "maxWidth": 0.95,
          "maxHeight": 0.15,
          "maxArea": 0.12
        }
      },
      "steps": [
        {
          "find": {
            "by": "text",
            "match": [
              "金币定位280-0-0"
            ],
            "normalise": [
              {
                "pattern": "^返回$",
                "replace": "金币定位280-0-0"
              }
            ]
          },
          "need": {
            "visibleText": [
              "每日任务"
            ],
            "absentText": [
              "观看广告+",
              "点击后看"
            ]
          },
          "do": {
            "capability": "swipe",
            "from": [
              0.6,
              0.85
            ],
            "to": [
              0.6,
              0.8132
            ],
            "speed": 400
          },
          "expect": {
            "result": "appeared",
            "match": [
              "金币TAB"
            ],
            "samples": 2,
            "settleMs": 3000
          }
        }
      ]
