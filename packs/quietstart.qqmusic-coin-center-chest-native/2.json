{
  "schema": 3,
  "id": "quietstart.qqmusic-coin-center-chest-native",
  "name": "QQ音乐金币中心·宝箱视频跳转",
  "version": 2,
  "minAppVersionCode": 128000,
  "minAppVersionName": "1.2.8",
  "usage": "【使用前必读】请先关闭「QQ音乐免会员视频任务」工具包，否则会与金币任务冲突。本配置处理第3区宝箱原生视频，详情跳转停留3秒，读到奖励完成提示后关闭广告。与其余金币配置一起启用。",
  "appliesTo": [
    "com.tencent.hm.qqmusic"
  ],
  "entryAfterClick": "免费领礼物-鸿蒙",
  "entryClickTexts": [
    "赚金币",
    "看广告后可领取"
  ],
  "landingVisit": {
    "promptText": "可获得奖励",
    "promptKeywords": [
      "点击"
    ],
    "maxPendingRetries": 3,
    "promptRegion": [
      0.02,
      0.03,
      0.96,
      0.3
    ],
    "buttonRegion": [
      0.05,
      0.73,
      0.95,
      0.95
    ],
    "dwellMs": 3000,
    "chooserTexts": [
      "选择应用",
      "选择打开方式",
      "应用分身",
      "打开方式",
      "微信1"
    ],
    "confirmContexts": [
      "是否确认",
      "确认打开",
      "即将打开",
      "是否打开",
      "想要打开"
    ],
    "confirmButton": "确定",
    "confirmButtons": [
      "打开"
    ],
    "externalOpenPolicy": "open",
    "cancelButton": "取消",
    "dismissPoint": [
      0.5,
      0.15
    ],
    "backFrom": [
      0.005,
      0.52
    ],
    "backTo": [
      0.285,
      0.52
    ],
    "backSpeed": 2600,
    "externalReturnText": "QQ音乐",
    "returnPolicy": "navigation",
    "returnAbility": {
      "moduleName": "entry",
      "abilityName": "EntryAbility"
    },
    "earnedTexts": [
      "恭喜已获得奖励",
      "恭喜获得奖励",
      "恭喜你已获得奖励",
      "金币TAB"
    ],
    "landingPages": [
      {
        "containerType": "UIExtensionComponent",
        "allIds": [
          "app_name",
          "download_button_text"
        ],
        "anyText": [
          "安装",
          "打开",
          "更新"
        ],
        "dwellMs": 3000,
        "returnPolicy": "back-then-wake-owner",
        "wakeFromBundles": [
          "com.huawei.hmsapp.appgallery"
        ]
      }
    ]
  },
  "tasks": [
    {
      "schema": 2,
      "id": "quietstart.qqmusic-coin-center-daily-native-2",
      "name": "第3区弹窗视频任务2",
      "version": 1,
      "priority": 312,
      "appliesTo": [
        "com.tencent.hm.qqmusic"
      ],
      "when": {
        "trigger": "app-foreground",
        "lifetime": "foreground"
      },
      "defaults": {
        "totalMs": 240000,
        "limit": {
          "maxWidth": 0.95,
          "maxHeight": 0.15,
          "maxArea": 0.12
        }
      },
      "steps": [
        {
          "find": {
            "by": "text",
            "match": [
              "金币视频已入场"
            ],
            "normalise": [
              {
                "pattern": "^查看详情$",
                "replace": "金币视频已入场"
              }
            ],
            "limit": {
              "maxWidth": 0.95,
              "maxHeight": 0.1,
              "maxArea": 0.12
            }
          },
          "need": {
            "visibleText": [
              "可获得奖励",
              "恭喜已获得奖励",
              "已观看广告"
            ]
          },
          "do": {
            "capability": "swipe",
            "from": [
              0.96,
              0.36
            ],
            "to": [
              0.96,
              0.35
            ],
            "speed": 1000
          },
          "expect": {
            "result": "appeared",
            "match": [
              "查看详情"
            ],
            "settleMs": 3000,
            "samples": 2
          }
        },
        {
          "find": {
            "by": "text",
            "match": [
              "关闭广告"
            ],
            "explicit": false,
            "idHints": [
              [
                "close",
                "金币定位312-5-1"
              ],
              [
                "CloseButton",
                "金币定位312-5-1"
              ],
              [
                "close_text",
                "金币定位312-5-1"
              ]
            ],
            "limit": {
              "maxWidth": 0.12,
              "maxHeight": 0.08,
              "maxArea": 0.01
            }
          },
          "need": {
            "visibleText": [
              "恭喜已获得奖励",
              "恭喜获得奖励",
              "恭喜你已获得奖励",
              "已观看广告"
            ],
            "evidence": {
              "text": [
                "恭喜已获得奖励",
                "恭喜获得奖励",
                "恭喜你已获得奖励",
                "已观看广告"
              ]
            }
          },
          "do": {
            "capability": "click"
          },
          "expect": {
            "result": "gone",
            "settleMs": 15000,
            "samples": 2
          },
          "skipWhen": {
            "visibleText": [
              "金币TAB"
            ],
            "absentText": [
              "点击后看",
              "恭喜已获得奖励",
              "恭喜获得奖励",
              "已观看广告"
            ],
            "stopRepeat": false
          }
        },
        {
          "find": {
            "by": "text",
            "match": [
              "金币定位312-5-2"
            ],
            "normalise": [
              {
                "pattern": "^关闭$",
                "replace": "金币定位312-5-2"
              }
            ],
            "limit": {
              "maxWidth": 0.24,
              "maxHeight": 0.1,
              "maxArea": 0.02
            }
          },
          "need": {
            "visibleText": [
              "看广告后可领取"
            ],
            "absentText": [
              "点击后看",
              "恭喜已获得奖励"
            ]
          },
          "do": {
            "capability": "click"
          },
          "expect": {
            "result": "gone",
            "settleMs": 5000,
            "samples": 2
          },
          "skipWhen": {
            "visibleText": [
              "金币TAB"
            ],
            "absentText": [
              "看广告后可领取"
            ],
            "stopRepeat": false
          }
        }
      ]
    }
  ],
  "priority": 312
}
